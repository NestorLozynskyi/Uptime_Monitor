# Copy to .env to override the Docker Compose defaults. Never commit .env.

# Host port for the web app (http://localhost:4000).
APP_PORT=4000
# Public host name used for generated URLs and LiveView origin checks.
PHX_HOST=localhost

# Session signing key. Generate with `mix phx.gen.secret`. When empty, an
# ephemeral key is generated on each start (sessions reset on restart).
SECRET_KEY_BASE=

# Administrator created on first start if no admin exists yet.
# The defaults below are the documented demo credentials — change them.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=uptime-demo-2026

# PostgreSQL password for the bundled database container.
POSTGRES_PASSWORD=postgres

# --- Used by the app (set in docker-compose.yml for the demo) ---
# SSRF_ALLOWLIST: comma-separated host names, IPs or CIDRs that may be
# monitored even though they are private/loopback. Empty by default.
# SSRF_ALLOWLIST=demo-target
# DEMO_SEED=true                 # seed demo services on first start
# DEMO_TARGET_URL=http://demo-target:4100
